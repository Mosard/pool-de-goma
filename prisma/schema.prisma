generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("POSTGRES_URL")
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserStatus {
  PENDING
  ACTIVE
  SUSPENDED
  DISABLED
}

enum Sex {
  M
  F
}

enum RoleScope {
  PROVINCE
  POOL
}

enum AccountRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum InspectionStatus {
  PLANIFIEE
  EN_COURS
  TERMINEE
  RAPPORT_SOUMIS
  VALIDEE
}

enum NotificationChannel {
  IN_APP
  EMAIL
  WHATSAPP
  SMS
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
  DISABLED
}

// ---------------------------------------------------------------------------
// Organisation territoriale
// ---------------------------------------------------------------------------

// Une Organization est une IPP (ex. "IPP Nord-Kivu 1") : la plateforme est
// générique et peut héberger plusieurs organisations, chacune avec ses
// propres pools (Goma, Karisimbi, ...). Le déploiement actuel n'en sert
// qu'une seule, mais toute la donnée est déjà scoping-ready.
model Organization {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  pools                 Pool[]
  users                 User[]
  accountRequests       AccountRequest[]
  directionAttributions DirectionAttribution[]
  contents              Content[]
  aiAnalyses            AiAnalysis[]
}

// Contenus éditoriaux du site public (actualités, articles, communiqués).
// Rédigés par le chargé des médias (content.write), publiés après validation
// par un compte habilité (content.publish : IPP, IPP adjoint, informaticien,
// Super Admin), jamais par leur propre auteur.
enum ContentKind {
  ACTUALITE
  ARTICLE
  COMMUNIQUE
  GALERIE
}

enum ContentStatus {
  BROUILLON
  SOUMIS
  A_CORRIGER
  PUBLIE
  RETIRE
}

enum MediaRole {
  COVER // image de couverture (une par contenu)
  INLINE // image insérée dans le texte
  ATTACHMENT // PDF joint (communiqué)
  GALLERY // photo d'album (galerie du contenu)
}

model Content {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id])
  kind           ContentKind
  status         ContentStatus @default(BROUILLON)
  title          String
  // URL publique (/actualites/<slug>), figée à la première publication.
  slug           String        @unique
  summary        String
  // Texte au format de l'éditeur simple (sous-ensemble de Markdown, rendu
  // sans HTML libre : src/lib/content-markup.tsx).
  body           String        @db.Text
  authorId       String
  author         User          @relation("ContentAuthor", fields: [authorId], references: [id])
  submittedAt    DateTime?
  // Dernière décision de validation (publication, renvoi, retrait).
  reviewedById   String?
  reviewedBy     User?         @relation("ContentReviewer", fields: [reviewedById], references: [id])
  reviewedAt     DateTime?
  reviewNote     String?
  // Date de mise en ligne (passée ou future : un contenu programmé est
  // PUBLIE avec une date future et reste invisible jusqu'à cette date).
  publishedAt    DateTime?
  // Date de publication souhaitée par l'auteur, proposée au valideur.
  scheduledFor   DateTime?
  // Catégorie éditoriale (clé de CONTENT_CATEGORIES, src/lib/content-meta.ts).
  category       String?
  // Liens YouTube / Facebook intégrés à la page (5 au plus).
  videoLinks     String[]      @default([])
  // « À la une » : épinglé par un valideur (accueil et page Actualités).
  pinnedAt       DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  media MediaFile[]

  @@index([organizationId, status, publishedAt])
  @@index([authorId])
}

// Fichier d'un contenu (image compressée ou PDF), stocké en base. Servi par
// /medias/<id> : public seulement si le contenu est publié.
model MediaFile {
  id           String    @id @default(cuid())
  contentId    String
  content      Content   @relation(fields: [contentId], references: [id], onDelete: Cascade)
  role         MediaRole
  mime         String
  data         Bytes
  size         Int
  width        Int?
  height       Int?
  alt          String?
  fileName     String?
  uploadedById String
  uploadedBy   User      @relation("MediaUploader", fields: [uploadedById], references: [id])
  createdAt    DateTime  @default(now())

  @@index([contentId, role])
}

// Attribution d'un IPP adjoint (domaine dont il est chargé : Formation,
// Évaluation, Titres…). Créée et modifiée par l'IPP principal (permission
// direction.manage) ; elle ne remplace pas le rôle « ipa » du compte, elle
// décrit son domaine. Une attribution sans titulaire publié reste une place
// neutre sur le site (libellé seul, jamais de nom ni de portrait fictif).
model DirectionAttribution {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  label          String
  // Ordre d'affichage (croissant), puis libellé.
  position       Int          @default(0)
  // Compte titulaire (rôle « ipa »). Vide : place non attribuée.
  holderId       String?
  holder         User?        @relation("DirectionHolder", fields: [holderId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  aiProblems AiProblem[]

  @@unique([organizationId, label])
  @@index([holderId])
}

model Pool {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id])
  name              String
  code              String       @unique
  active            Boolean      @default(true)
  // Fiche publique : un POOL n'apparaît sur le site que s'il est actif et
  // qu'un slug lui a été attribué depuis l'administration. Le slug fixe son
  // URL publique (/pools/<slug>) et n'est jamais recalculé à partir du nom.
  slug              String?      @unique
  // Seules coordonnées publiées pour le bureau du POOL (décision de
  // l'Inspection) : adresse officielle et e-mail institutionnel.
  address           String?
  officialEmail     String?
  // Téléphone du bureau du POOL : visible dans l'application seulement, jamais
  // publié (décision de l'Inspection : aucun téléphone sur le site public).
  officePhone       String?
  // Passage EXPLICITE de la page publique en mode officiel, décidé par
  // l'IPP ou l'informaticien. Tant qu'il est vide, un POOL qui dispose d'une
  // maquette (src/lib/pool-demo) l'affiche entièrement, même si une école ou
  // un agent est déjà publié ; une fois renseigné, plus aucune donnée
  // fictive n'apparaît sur la page.
  officialPageSince DateTime?
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  schools         School[]
  users           User[]
  userRoles       UserRole[]
  accountRequests AccountRequest[]
  aiAnalyses      AiAnalysis[]

  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// RBAC dynamique
// ---------------------------------------------------------------------------

model RoleDefinition {
  id          String    @id @default(cuid())
  key         String    @unique
  label       String
  description String?
  scope       RoleScope
  isSystem    Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  rolePermissions RolePermission[]
  userRoles       UserRole[]
  accountRequests AccountRequest[]
}

model Permission {
  id       String @id @default(cuid())
  key      String @unique
  label    String
  category String

  rolePermissions RolePermission[]
}

model RolePermission {
  id           String         @id @default(cuid())
  roleId       String
  role         RoleDefinition @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permissionId String
  permission   Permission     @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
}

model UserRole {
  id        String         @id @default(cuid())
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  roleId    String
  role      RoleDefinition @relation(fields: [roleId], references: [id], onDelete: Cascade)
  poolId    String?
  pool      Pool?          @relation(fields: [poolId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now())

  @@unique([userId, roleId, poolId])
  @@index([userId])
}

// ---------------------------------------------------------------------------
// Comptes & activation
// ---------------------------------------------------------------------------

model User {
  id                         String       @id @default(cuid())
  name                       String
  email                      String       @unique
  // Identifiant de connexion choisi par la personne (minuscules). Distinct du
  // nom, que plusieurs personnes peuvent partager. Vide pour les comptes
  // antérieurs, qui se connectent avec leur e-mail.
  username                   String?      @unique
  passwordHash               String
  status                     UserStatus   @default(PENDING)
  sex                        Sex?
  phone                      String?
  organizationId             String
  organization               Organization @relation(fields: [organizationId], references: [id])
  poolId                     String?
  pool                       Pool?        @relation(fields: [poolId], references: [id])
  // Profil détaillé (§18 du design) — additifs, `name` reste le nom complet
  // affiché partout ailleurs dans l'application.
  postnom                    String?
  prenom                     String?
  dateNaissance              DateTime?
  matricule                  String?
  statutAdministratif        String?
  mecanise                   Boolean?
  nombreEnfants              Int?
  photoUrl                   String?      @db.Text
  photoUpdatedAt             DateTime?
  // Compte de démonstration (seed) : jamais publié ni présenté comme
  // officiel, et sans effet sur les informations officielles.
  isDemo                     Boolean      @default(false)
  // Publication sur le site public : il faut À LA FOIS l'accord de l'agent
  // (consent*, donné depuis son profil) et l'autorisation de l'IPP ou de
  // l'informaticien (auth*). La photo exige en plus l'accord et
  // l'autorisation sur l'identité. Historique : PublicationRecord.
  publicationConsentIdentity Boolean      @default(false)
  publicationConsentPhoto    Boolean      @default(false)
  publicationAuthIdentity    Boolean      @default(false)
  publicationAuthPhoto       Boolean      @default(false)
  createdAt                  DateTime     @default(now())
  updatedAt                  DateTime     @updatedAt

  roles                   UserRole[]
  assignmentsGiven        Assignment[]           @relation("AssignedBy")
  assignmentsEnded        Assignment[]           @relation("EndedBy")
  publicationRecords      PublicationRecord[]    @relation("PublicationSubject")
  publicationDecisions    PublicationRecord[]    @relation("PublicationActor")
  directionAttributions   DirectionAttribution[] @relation("DirectionHolder")
  contentsAuthored        Content[]              @relation("ContentAuthor")
  contentsReviewed        Content[]              @relation("ContentReviewer")
  mediaUploaded           MediaFile[]            @relation("MediaUploader")
  assignments             Assignment[]           @relation("Inspector")
  inspections             Inspection[]           @relation("InspectorInspections")
  comments                Comment[]
  reviewedAccountRequests AccountRequest[]       @relation("ReviewedBy")
  notifications           Notification[]
  passwordResetTokens     PasswordResetToken[]
  auditLogs               AuditLog[]
  reportTransitions       ReportStatusHistory[]
  uploadedAttachments     Attachment[]
  aiAnalyses              AiAnalysis[]
  aiReactions             AiReaction[]

  @@index([organizationId])
  @@index([poolId])
  @@index([status])
}

model AccountRequest {
  id              String               @id @default(cuid())
  name            String
  email           String
  // Identifiant et empreinte bcrypt du mot de passe choisis par le demandeur.
  // L'empreinte passe au compte à la validation, puis est effacée de la
  // demande (effacée aussi en cas de refus). Jamais affichée.
  username        String?
  passwordHash    String?
  phone           String?
  message         String?
  requestedRoleId String?
  requestedRole   RoleDefinition?      @relation(fields: [requestedRoleId], references: [id])
  organizationId  String
  organization    Organization         @relation(fields: [organizationId], references: [id])
  poolId          String?
  pool            Pool?                @relation(fields: [poolId], references: [id])
  status          AccountRequestStatus @default(PENDING)
  reviewedById    String?
  reviewedBy      User?                @relation("ReviewedBy", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@index([organizationId])
  @@index([status])
  @@index([username])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
}

// ---------------------------------------------------------------------------
// Référentiel des écoles
// ---------------------------------------------------------------------------

model School {
  id         String   @id @default(cuid())
  poolId     String
  pool       Pool     @relation(fields: [poolId], references: [id])
  name       String
  code       String   @unique
  province   String
  territoire String
  address    String?
  director   String?
  phone      String?
  type       String?
  active     Boolean  @default(true)
  // École de démonstration (seed) : jamais publiée.
  isDemo     Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  assignments Assignment[]
  inspections Inspection[]

  @@index([poolId])
  @@index([province, territoire])
}

model Assignment {
  id            String    @id @default(cuid())
  school        School    @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId      String
  inspector     User      @relation("Inspector", fields: [inspectorId], references: [id], onDelete: Cascade)
  inspectorId   String
  assignedBy    User      @relation("AssignedBy", fields: [assignedById], references: [id])
  assignedById  String
  active        Boolean   @default(true)
  createdAt     DateTime  @default(now())
  // Date d'effet (pas de date de fin obligatoire). Une affectation n'est
  // valable qu'à partir de cette date et tant qu'elle n'est pas terminée.
  effectiveFrom DateTime  @default(now())
  // Historique : une affectation terminée est conservée (jamais supprimée).
  endedAt       DateTime?
  endReason     String?
  endedById     String?
  endedBy       User?     @relation("EndedBy", fields: [endedById], references: [id])

  @@index([inspectorId])
  @@index([schoolId])
}

enum PublicationDecisionKind {
  CONSENT // accord de l'agent lui-même
  AUTHORIZATION // autorisation de l'IPP ou de l'informaticien
}

enum PublicationScope {
  IDENTITY // nom et fonction
  PHOTO
}

// Trace interne des accords, autorisations et retraits de publication
// (granted = false pour un retrait). Jamais modifiée ni supprimée.
model PublicationRecord {
  id        String                  @id @default(cuid())
  userId    String
  user      User                    @relation("PublicationSubject", fields: [userId], references: [id], onDelete: Cascade)
  actorId   String?
  actor     User?                   @relation("PublicationActor", fields: [actorId], references: [id])
  kind      PublicationDecisionKind
  scope     PublicationScope
  granted   Boolean
  // Motif système éventuel (ex. "photo_changed", "account_suspended").
  reason    String?
  createdAt DateTime                @default(now())

  @@index([userId, createdAt])
}

// ---------------------------------------------------------------------------
// Types d'inspection & fiches dynamiques
// ---------------------------------------------------------------------------

model InspectionCategory {
  id          String   @id @default(cuid())
  code        String   @unique
  label       String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  formTemplates FormTemplate[]
}

model FormTemplate {
  id           String             @id @default(cuid())
  categoryId   String
  category     InspectionCategory @relation(fields: [categoryId], references: [id])
  code         String             @unique
  title        String
  version      Int                @default(1)
  fieldsSchema Json
  active       Boolean            @default(true)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  forms Form[]
}

model Inspection {
  id            String           @id @default(cuid())
  school        School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  schoolId      String
  inspector     User             @relation("InspectorInspections", fields: [inspectorId], references: [id], onDelete: Cascade)
  inspectorId   String
  status        InspectionStatus @default(PLANIFIEE)
  scheduledDate DateTime?
  completedAt   DateTime?
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt

  forms  Form[]
  report Report?

  @@index([schoolId])
  @@index([inspectorId])
  @@index([status])
}

model Form {
  id             String       @id @default(cuid())
  inspection     Inspection   @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  inspectionId   String
  formTemplateId String
  formTemplate   FormTemplate @relation(fields: [formTemplateId], references: [id])
  data           Json         @default("{}")
  completed      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([inspectionId, formTemplateId])
}

// ---------------------------------------------------------------------------
// Circuit d'exploitation & validation (configurable)
// ---------------------------------------------------------------------------

model WorkflowStatus {
  id         String   @id @default(cuid())
  key        String   @unique
  label      String
  order      Int
  isTerminal Boolean  @default(false)
  createdAt  DateTime @default(now())

  reports         Report[]
  transitionsFrom WorkflowTransition[] @relation("FromStatus")
  transitionsTo   WorkflowTransition[] @relation("ToStatus")
}

model WorkflowTransition {
  id                   String         @id @default(cuid())
  fromStatusId         String
  fromStatus           WorkflowStatus @relation("FromStatus", fields: [fromStatusId], references: [id], onDelete: Cascade)
  toStatusId           String
  toStatus             WorkflowStatus @relation("ToStatus", fields: [toStatusId], references: [id], onDelete: Cascade)
  label                String
  allowedPermissionKey String

  @@unique([fromStatusId, toStatusId])
}

model Report {
  id              String         @id @default(cuid())
  inspection      Inspection     @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  inspectionId    String         @unique
  summary         String?
  recommendations String?
  statusId        String
  status          WorkflowStatus @relation(fields: [statusId], references: [id])
  submittedAt     DateTime?
  validatedAt     DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  comments      Comment[]
  statusHistory ReportStatusHistory[]
  attachments   Attachment[]

  @@index([statusId])
}

model ReportStatusHistory {
  id           String   @id @default(cuid())
  reportId     String
  report       Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  fromStatusId String?
  toStatusId   String
  changedById  String
  changedBy    User     @relation(fields: [changedById], references: [id])
  comment      String?
  createdAt    DateTime @default(now())

  @@index([reportId])
}

model Comment {
  id        String   @id @default(cuid())
  report    Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  reportId  String
  author    User     @relation(fields: [authorId], references: [id])
  authorId  String
  content   String
  createdAt DateTime @default(now())

  @@index([reportId])
}

model Attachment {
  id           String   @id @default(cuid())
  reportId     String
  report       Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)
  fileName     String
  mimeType     String
  sizeBytes    Int
  storagePath  String
  uploadedById String
  uploadedBy   User     @relation(fields: [uploadedById], references: [id])
  createdAt    DateTime @default(now())

  @@index([reportId])
}

// ---------------------------------------------------------------------------
// Audit & traçabilité
// ---------------------------------------------------------------------------

model AuditLog {
  id             String   @id @default(cuid())
  actorId        String?
  actor          User?    @relation(fields: [actorId], references: [id])
  organizationId String
  action         String
  entityType     String
  entityId       String
  oldValue       Json?
  newValue       Json?
  metadata       Json?
  createdAt      DateTime @default(now())

  @@index([entityType, entityId])
  @@index([createdAt])
  @@index([organizationId])
}

// ---------------------------------------------------------------------------
// Notifications
// ---------------------------------------------------------------------------

model Notification {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   NotificationChannel
  event     String
  title     String
  body      String
  payload   Json?
  status    NotificationStatus  @default(PENDING)
  readAt    DateTime?
  createdAt DateTime            @default(now())
  sentAt    DateTime?

  @@index([userId, status])
}

// ---------------------------------------------------------------------------
// IA : analyse des rapports des inspecteurs itinérants
// ---------------------------------------------------------------------------
// Une analyse lit les rapports existants (Report + Form) d'un périmètre (un
// POOL, ou toute l'inspection si poolId est vide) sur une période, et propose
// des problèmes classés. Aucune décision n'est appliquée automatiquement :
// chaque proposition attend la réaction d'un responsable (AiReaction).

enum AiAnalysisStatus {
  REUSSIE
  ECHOUEE
}

enum AiGravity {
  CRITIQUE
  ELEVEE
  MODEREE
  FAIBLE
}

enum AiDecisionStatus {
  PROPOSEE
  VALIDEE
  REJETEE
  AJUSTEE
}

enum AiReactionKind {
  VALIDATION
  REJET
  AJUSTEMENT
  COMMENTAIRE
  SERVICE_DESIGNE
}

model AiAnalysis {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id])
  // Vide : toute l'inspection.
  poolId         String?
  pool           Pool?            @relation(fields: [poolId], references: [id], onDelete: Restrict)
  periodFrom     DateTime
  periodTo       DateTime
  authorId       String
  author         User             @relation(fields: [authorId], references: [id])
  status         AiAnalysisStatus
  model          String
  // Identifiants des rapports envoyés au modèle (traçabilité).
  reportIds      String[]         @default([])
  synthese       String?          @db.Text
  limites        Json?
  error          String?
  // Lancée depuis un compte de démonstration : ne porte que sur des données
  // de démonstration et n'engage personne.
  isDemo         Boolean          @default(false)
  inputTokens    Int?
  outputTokens   Int?
  createdAt      DateTime         @default(now())

  problems AiProblem[]

  @@index([organizationId, createdAt])
  @@index([poolId, createdAt])
}

model AiProblem {
  id                 String                @id @default(cuid())
  analysisId         String
  analysis           AiAnalysis            @relation(fields: [analysisId], references: [id], onDelete: Cascade)
  // Ordre proposé par l'analyse (0 = plus prioritaire).
  rank               Int
  titre              String
  constat            String                @db.Text
  gravite            AiGravity
  nbRapports         Int
  sites              Json
  periode            String
  sources            Json
  hypothese          String                @db.Text
  aVerifier          String                @db.Text
  decisionProposee   String                @db.Text
  // Service tel que nommé par l'analyse, et attribution de la Direction
  // reconnue (ou désignée ensuite par l'IPP). Vide : à confirmer.
  serviceResponsable String
  attributionId      String?
  attribution        DirectionAttribution? @relation(fields: [attributionId], references: [id], onDelete: SetNull)
  delaiIndicatif     String
  resultatAttendu    String                @db.Text
  status             AiDecisionStatus      @default(PROPOSEE)
  // Décision retenue après ajustement, et motif du dernier rejet.
  decisionAjustee    String?               @db.Text
  motifRejet         String?               @db.Text
  decidedAt          DateTime?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt

  reactions AiReaction[]

  @@index([analysisId, rank])
  @@index([status])
  @@index([attributionId])
}

// Journal des réactions : ajout seul, jamais modifié ni supprimé.
model AiReaction {
  id              String         @id @default(cuid())
  problemId       String
  problem         AiProblem      @relation(fields: [problemId], references: [id], onDelete: Cascade)
  authorId        String
  author          User           @relation(fields: [authorId], references: [id])
  kind            AiReactionKind
  comment         String?        @db.Text
  motif           String?        @db.Text
  decisionAjustee String?        @db.Text
  attributionId   String?
  createdAt       DateTime       @default(now())

  @@index([problemId, createdAt])
}
